# =================================================================
# BUILD WITH HARI — BACKEND & CLOUD RUN ENVIRONMENT CONFIGURATION
# =================================================================

# Server port (automatically provided by Cloud Run, defaults to 3000 locally)
PORT=3000

# Environment mode ('development' | 'production' | 'test')
NODE_ENV=production

# GEMINI_API_KEY: Required for Gemini Developer API syllabus document analysis
# Kept strictly server-side. Load from Secret Manager in Cloud Run.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GCP Project ID for Firestore and Cloud Logging
GOOGLE_CLOUD_PROJECT="gen-lang-client-0494322977"

# Firestore database ID (defaults to '(default)')
FIRESTORE_DATABASE_ID="(default)"

# Allowed CORS origins for external frontend clients (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Public URL where the application or API is hosted (e.g. Cloud Run service URL)
APP_URL="https://build-by-hari-api-XXXXXXXXXX-el.a.run.app"

# Optional notification recipient email for studio enquiry alerts
NOTIFICATION_EMAIL="harinandhan972@gmail.com"

# Optional client-side API base URL override for standalone frontend deployments
# Leave empty when frontend is served from the same Express instance.
VITE_API_BASE_URL=""
