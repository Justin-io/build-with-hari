{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://build-by-hari-api-308291525318.asia-south1.run.app/api/$1"
    },
    {
      "source": "/healthz",
      "destination": "https://build-by-hari-api-308291525318.asia-south1.run.app/api/healthz"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
